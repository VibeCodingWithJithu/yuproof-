# Copy to .env.local. `npm run seed` fills the chain values for a local Hardhat node.

# Base URL printed in document QR codes
PUBLIC_BASE_URL=https://yuproof.yubhiantechnologies.in

# Postgres (Neon / Supabase / RDS). Leave unset in dev to use embedded PGlite in .data/
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Blockchain (read-only for verification)
CHAIN_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
CHAIN_NAME=Polygon Amoy
CHAIN_EXPLORER_TX_URL=https://amoy.polygonscan.com/tx/
ISSUER_REGISTRY_ADDRESS=0x9FDaF078B7A9A0c8A430eEce6700AeaDc1Fa2DCE
DOCUMENT_REGISTRY_ADDRESS=0xF25CaB7Ac589b9483D76b1bd4f41EF3cB4994F23
